---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

export interface Props {
  entry: CollectionEntry<"press">;
}

const { entry } = Astro.props;
const { title, publication, publishDate, url, description, featured } =
  entry.data;

const formattedDate = new Date(publishDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div
  class:list={[
    "group relative flex h-full flex-col bg-white dark:bg-stone-800 rounded-xl border overflow-hidden transition-colors",
    featured
      ? "border-accent-500 dark:border-accent-400"
      : "border-stone-200 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-700/50",
  ]}
>
  {
    featured && (
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-accent-100 dark:bg-accent-900/50 text-accent-800 dark:text-accent-300">
          <Icon name="mdi:star" class="w-3 h-3" />
          Featured
        </span>
      </div>
    )
  }

  <div class="p-6 flex flex-col flex-1">
    <!-- Publication + date -->
    <div class="flex items-center gap-2 mb-3">
      <Icon
        name="mdi:newspaper-variant-outline"
        class="w-5 h-5 text-accent-700 dark:text-accent-400 shrink-0"
      />
      <span class="text-sm font-medium text-accent-800 dark:text-accent-300">
        {publication}
      </span>
      <span class="text-stone-300 dark:text-stone-600">·</span>
      <time
        datetime={new Date(publishDate).toISOString()}
        class="text-sm text-stone-500 dark:text-stone-400"
      >
        {formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h3
      class="text-stone-900 dark:text-stone-100 font-semibold text-base leading-snug mb-3"
    >
      {title}
    </h3>

    <!-- Description -->
    <p
      class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed line-clamp-3 flex-1"
    >
      {description}
    </p>

    <!-- CTA -->
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-700 dark:text-accent-400 hover:text-accent-900 dark:hover:text-accent-200 transition-colors"
    >
      Read article
      <Icon name="mdi:open-in-new" class="w-4 h-4" />
    </a>
  </div>
</div>
