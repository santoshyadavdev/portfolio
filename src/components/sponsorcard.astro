---
export interface Props {
  login: string;
  name?: string | null;
  avatarUrl: string;
  url: string;
}

const { login, name, avatarUrl, url } = Astro.props;
const displayName = name || login;
---

<div class="group relative h-full">
  <div
    class="relative flex h-full min-h-[20rem] w-full bg-white dark:bg-stone-800 rounded-xl border border-stone-200 dark:border-stone-700 overflow-hidden transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <div class="flex flex-col items-center justify-center p-6 h-full">
      <img
        src={avatarUrl}
        alt={displayName}
        class="w-32 h-32 rounded-full object-cover mb-4 border-4 border-stone-200 dark:border-stone-700"
      />
      <h3
        class="text-xl font-semibold text-stone-900 dark:text-stone-100 text-center mb-2"
      >
        {displayName}
      </h3>
      {
        name && login !== name && (
          <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">
            @{login}
          </p>
        )
      }
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-press mt-auto inline-block py-2 px-4 rounded-lg bg-accent-700 hover:bg-accent-800 dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 text-white text-sm font-medium"
      >
        View Profile
      </a>
    </div>
  </div>
</div>
