---
import type { NewsletterItem } from "../lib/newsletter";
import { Icon } from "astro-icon/components";

export interface Props {
  items: NewsletterItem[];
}

const { items } = Astro.props;

const featured = items[0];
---

{
  featured && (
    <div class="bg-white dark:bg-stone-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="flex flex-row flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 dark:text-stone-100">
            weeklyfive
          </h2>
          <a
            href={import.meta.env.BASE_URL + "newsletter"}
            class="inline-flex items-center gap-1 text-sm font-medium text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400"
          >
            View All Issues
            <Icon name="mdi:arrow-right" class="w-4 h-4" />
          </a>
        </div>
        <div class="mt-8 lg:mt-10 border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-800 rounded-xl overflow-hidden md:grid md:grid-cols-12 transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50">
          <a
            href={featured.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block md:col-span-8 p-6"
          >
            <p class="text-sm text-stone-500 dark:text-stone-400">
              Latest issue
              {featured.pubDate.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
              })}
            </p>
            <h3 class="mt-2 text-xl font-semibold text-stone-900 dark:text-stone-100">
              {featured.title}
            </h3>
            <p class="mt-3 text-stone-600 dark:text-stone-400 leading-relaxed line-clamp-2 max-w-[65ch]">
              {featured.description.replace(/<[^>]*>/g, "").trim()}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400">
              Read Issue
              <Icon name="mdi:open-in-new" class="w-3.5 h-3.5" />
            </span>
          </a>
          <div class="md:col-span-4 border-t md:border-t-0 md:border-l border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/60 p-6 flex flex-col justify-center">
            <p class="text-stone-700 dark:text-stone-300 leading-relaxed">
              Five links about Angular and the web, every Friday.
            </p>
            <a
              href="https://weeklyfive.io/"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-press mt-4 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-accent-700 hover:bg-accent-800 text-white font-semibold text-sm"
            >
              Subscribe
              <Icon name="mdi:open-in-new" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  )
}
