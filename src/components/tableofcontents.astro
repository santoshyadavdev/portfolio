---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props as Props;
---

<h2
  id="table-of-contents-title"
  class="font-display text-sm font-medium text-stone-900 dark:text-stone-100"
>
  On this page
</h2>
<ol role="list" class="mt-4 py-1 text-sm">
  {
    headings
      .filter(({ depth }) => depth > 1 && depth < 4)
      .map((heading) => (
        <li
          class={
            heading.depth == 2
              ? "text-stone-500 dark:text-stone-400"
              : "mt-2 py-1 pl-5 text-stone-500 dark:text-stone-400"
          }
        >
          <a
            class="hover:text-accent-700 dark:hover:text-accent-400"
            href={`#${heading.slug}`}
          >
            {heading.text}
          </a>
        </li>
      ))
  }
</ol>
