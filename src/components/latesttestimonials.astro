---
import type { Testimonial } from "../lib/testimonials";
import { Icon } from "astro-icon/components";
import TestimonialCard from "./testimonialcard.astro";

export interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;

const displayTestimonials = testimonials.slice(0, 3);
---

{
  displayTestimonials.length > 0 && (
    <div class="bg-stone-50 dark:bg-stone-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="flex flex-row flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-2xl md:text-3xl font-semibold text-stone-900 dark:text-stone-100">
            Testimonials
          </h2>
          <a
            href={import.meta.env.BASE_URL + "testimonials"}
            class="inline-flex items-center gap-1 text-sm font-medium text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400"
          >
            View All Testimonials
            <Icon name="mdi:arrow-right" class="w-4 h-4" />
          </a>
        </div>
        <div class="mt-8 lg:mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {displayTestimonials.map((testimonial) => (
            <TestimonialCard
              id={testimonial.id}
              quote={testimonial.quote}
              authorLogin={testimonial.authorLogin}
              authorName={testimonial.authorName}
              authorAvatarUrl={testimonial.authorAvatarUrl}
              socialLinks={testimonial.socialLinks}
              createdAt={testimonial.createdAt}
            />
          ))}
        </div>
      </div>
    </div>
  )
}
