---
import { Icon } from "astro-icon/components";
import { NavigationLinks, SecondaryNavigationLinks, Logo } from "../config";
import Theme from "../components/theme.astro";
import Img from "../components/img.astro";

const navLinkClass = (active: boolean) =>
  (active
    ? "text-stone-900 dark:text-stone-100 underline decoration-accent-600 dark:decoration-accent-400 decoration-2 underline-offset-8"
    : "text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100") +
  " px-2 py-2 text-base font-medium transition-colors";
---

<div class="relative h-16 w-full">
  <nav x-data="{ isOpen: false }" @keydown.escape.window="isOpen = false">
    <div
      class="fixed inset-x-0 z-50 bg-white/95 dark:bg-stone-900/95 backdrop-blur border-b border-stone-200 dark:border-stone-700"
    >
      <div
        class="relative flex items-center justify-between h-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8"
      >
        <div class="absolute inset-y-0 left-0 flex items-center lg:hidden">
          <!-- Mobile menu button-->
          <button
            type="button"
            x-on:click="isOpen = !isOpen"
            class="cta-press inline-flex items-center justify-center p-2 rounded-lg text-stone-500 dark:text-stone-400 dark:focus:ring-accent-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-accent-600"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <Icon
              x-bind:class="{'hidden': isOpen, 'block': !isOpen }"
              class="block h-6 w-6"
              aria-hidden="true"
              name="mdi:menu"
            />
            <Icon
              x-bind:class="{'block': isOpen, 'hidden': !isOpen }"
              class="hidden h-6 w-6"
              aria-hidden="true"
              name="mdi:close"
            />
          </button>
        </div>
        <div
          class="flex-1 flex items-center justify-center lg:items-stretch lg:justify-start"
        >
          <div class="flex-shrink-0 flex items-center">
            <Img
              class="block h-8 w-8 rounded-full object-cover"
              src={Logo}
              alt="Logo"
            />
          </div>
          <div class="hidden lg:block lg:ml-8">
            <div class="flex space-x-5">
              {
                NavigationLinks.map((item) => (
                  <a
                    href={import.meta.env.BASE_URL + item.href}
                    class={navLinkClass(
                      item.href.length > 0 &&
                        Astro.url.toString().includes(item.href),
                    )}
                    aria-current={
                      item.href.length > 0 &&
                      Astro.url.toString().includes(item.href)
                        ? "page"
                        : undefined
                    }
                  >
                    {item.name}
                  </a>
                ))
              }
              <div class="relative" x-data="{ showMore: false }">
                <button
                  type="button"
                  x-on:click="showMore = !showMore"
                  @keydown.escape.window="showMore = false"
                  x-bind:aria-expanded="showMore"
                  aria-controls="more-menu"
                  class="cta-press inline-flex items-center px-2 py-2 text-base font-medium text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
                >
                  More
                  <Icon
                    class="motion-rotate w-4 h-4 ml-1"
                    x-bind:class="showMore && 'rotate-180'"
                    name="mdi:chevron-down"
                  />
                </button>
                <div
                  id="more-menu"
                  x-show="showMore"
                  x-cloak
                  x-on:click.outside="showMore = false"
                  x-transition:enter="motion-enter origin-top-left"
                  x-transition:enter-start="opacity-0 scale-[0.96]"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-transition:leave="motion-leave origin-top-left"
                  x-transition:leave-start="opacity-100 scale-100"
                  x-transition:leave-end="opacity-0 scale-[0.96]"
                  class="absolute left-0 mt-2 w-56 origin-top-left rounded-xl shadow-lg bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 py-2"
                >
                  {
                    SecondaryNavigationLinks.map((item) => (
                      <a
                        href={import.meta.env.BASE_URL + item.href}
                        class={
                          (Astro.url.toString().includes(item.href)
                            ? "text-accent-800 dark:text-accent-300 bg-stone-50 dark:bg-stone-900/60"
                            : "text-stone-600 dark:text-stone-300 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-900/60") +
                          " block px-4 py-2 text-sm font-medium"
                        }
                        aria-current={
                          Astro.url.toString().includes(item.href)
                            ? "page"
                            : undefined
                        }
                      >
                        {item.name}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="absolute inset-y-0 right-0 flex items-center sm:static sm:inset-auto sm:ml-6"
        >
          <Theme />
        </div>
      </div>
    </div>

    <!-- Mobile menu, show/hide based on menu state. -->
    <div
      x-show="isOpen"
      x-cloak
      x-transition:enter="motion-enter origin-top"
      x-transition:enter-start="opacity-0 -translate-y-[4%]"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="motion-leave origin-top"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-[4%]"
      class="fixed top-16 inset-x-0 z-50 origin-top lg:hidden"
      id="mobile-menu"
    >
      <div
        class="px-4 sm:px-6 py-3 bg-white dark:bg-stone-900 border-stone-200 dark:border-stone-700 border-t border-b max-h-[calc(100vh-4rem)] overflow-y-auto"
      >
        <div class="grid grid-cols-1 gap-1">
          {
            NavigationLinks.map((item) => (
              <a
                href={import.meta.env.BASE_URL + item.href}
                x-on:click="isOpen = false"
                class:list={[
                  item.href.length > 0 &&
                  Astro.url.toString().includes(item.href)
                    ? "text-stone-900 dark:text-stone-100 bg-stone-100 dark:bg-stone-800"
                    : "text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100",
                  "block rounded-lg px-3 py-2 text-base font-medium",
                ]}
                aria-current={
                  item.href.length > 0 &&
                  Astro.url.toString().includes(item.href)
                    ? "page"
                    : undefined
                }
              >
                {item.name}
              </a>
            ))
          }
          <div
            class="mt-2 pt-2 border-t border-stone-200 dark:border-stone-700"
          >
            <p
              class="px-3 py-1 text-xs font-medium uppercase tracking-wide text-stone-400 dark:text-stone-500"
            >
              More
            </p>
            {
              SecondaryNavigationLinks.map((item) => (
                <a
                  href={import.meta.env.BASE_URL + item.href}
                  x-on:click="isOpen = false"
                  class:list={[
                    Astro.url.toString().includes(item.href)
                      ? "text-stone-900 dark:text-stone-100 bg-stone-100 dark:bg-stone-800"
                      : "text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100",
                    "block rounded-lg px-3 py-2 text-base font-medium",
                  ]}
                  aria-current={
                    Astro.url.toString().includes(item.href)
                      ? "page"
                      : undefined
                  }
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </nav>
</div>
