---
import { Icon } from "astro-icon/components";
import Img from "../components/img.astro";
import { FeaturedSVG, SiteMetadata, HeroRoles } from "../config";

const rolesJson = JSON.stringify(HeroRoles);
---

<section class="bg-stone-50 dark:bg-stone-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-center py-12 sm:py-16"
    >
      <div class="lg:col-span-7">
        <h1
          class="text-5xl sm:text-6xl lg:text-7xl font-semibold leading-tight text-stone-900 dark:text-stone-100"
        >
          Santosh Yadav
        </h1>
        <p
          class="mt-3 relative text-xl sm:text-2xl font-medium text-accent-700 dark:text-accent-300"
          x-data={`{
            roles: ${rolesJson},
            current: 0,
            incoming: 0,
            crossing: false,
            reduce: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          }`}
          x-init="
            if (reduce) return;
            const id = setInterval(() => {
              incoming = (current + 1) % roles.length;
              crossing = true;
              setTimeout(() => {
                current = incoming;
                crossing = false;
              }, 200);
            }, 2800);
            document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });
          "
        >
          <span class="invisible block motion-reduce:hidden" aria-hidden="true"
            >Google Developer Expert</span
          >
          <span
            class="hero-role absolute inset-0"
            :class="crossing ? 'hero-role-out' : 'hero-role-in'"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            x-text="reduce ? roles.join(', ') : roles[current]"
            >{HeroRoles[0]}</span
          >
          <span
            class="hero-role absolute inset-0 motion-reduce:hidden"
            :class="reduce || !crossing ? 'hero-role-out' : 'hero-role-in'"
            aria-hidden="true"
            x-text="roles[incoming]"></span>
        </p>
        <p
          class="mt-4 text-lg leading-relaxed text-stone-600 dark:text-stone-300"
        >
          Building CodeRabbit, unlocking developer productivity through
          intelligent code reviews and scalable monorepo strategies.
        </p>

        <div class="mt-5 flex gap-5">
          {
            SiteMetadata.social.map((s) => (
              <a
                href={s.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="text-stone-400 hover:text-accent-700 dark:text-stone-500 dark:hover:text-accent-300 transition-colors duration-200"
              >
                <Icon name={s.icon} class="w-5 h-5 block" />
              </a>
            ))
          }
        </div>

        <p
          class="mt-5 text-lg leading-relaxed text-stone-600 dark:text-stone-300"
        >
          Host of This is Tech Talks, bridging complex engineering with
          developer success and empowering the next generation of developers.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
          <a
            href={import.meta.env.BASE_URL + "work-with-me"}
            class="cta-press inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent-700 hover:bg-accent-800 text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-accent-600 focus:ring-offset-2 dark:focus:ring-offset-stone-900"
          >
            Work with Me
            <Icon name="mdi:arrow-right" class="w-5 h-5" />
          </a>
          <a
            href={import.meta.env.BASE_URL + "contact"}
            class="cta-press inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-stone-300 dark:border-stone-600 text-stone-800 dark:text-stone-200 hover:border-accent-500 dark:hover:border-accent-500 font-semibold text-base focus:outline-none focus:ring-2 focus:ring-accent-600 focus:ring-offset-2 dark:focus:ring-offset-stone-900"
          >
            Get in Touch
          </a>
        </div>

        <p
          class="mt-6 text-sm text-stone-400 dark:text-stone-500"
          x-data="{ isMac: navigator.platform.toUpperCase().includes('MAC') }"
        >
          <kbd
            class="px-1.5 py-0.5 text-xs font-normal bg-stone-100 dark:bg-stone-800 border border-stone-300 dark:border-stone-600 rounded"
            x-text="isMac ? '⌘ K' : 'Ctrl K'">⌘ K</kbd
          >
          opens the command center
        </p>
      </div>

      <div class="lg:col-span-5">
        <figure
          class="rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 overflow-hidden"
        >
          <Img
            class="w-full h-64 sm:h-80 lg:h-96 object-cover object-top"
            src={FeaturedSVG}
            alt="Illustrated portrait of Santosh Yadav"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-role {
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .hero-role-in {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-role-out {
    opacity: 0;
    transform: translateY(8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-role {
      transition: none;
      transform: none;
      position: static;
    }
  }
</style>
