---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CardFooter from "./cardfooter.astro";

export interface Props {
  talk: CollectionEntry<"talks">;
}

const { talk } = Astro.props;
---

<section class="h-full">
  <div
    class="h-full flex flex-col border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-800 rounded-xl overflow-hidden p-6 transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <h3 class="text-xl font-semibold text-stone-900 dark:text-stone-100">
      {talk.data.title}
    </h3>

    <p class="mt-2 text-sm text-stone-500 dark:text-stone-400 font-medium">
      {talk.data.event}
    </p>

    <div
      class="mt-3 flex items-center flex-wrap gap-3 text-sm text-stone-500 dark:text-stone-400"
    >
      <span class="inline-flex items-center">
        <Icon class="w-4 h-4 mr-1" name="mdi:calendar" />
        {talk.data.eventDate.toDateString()}
      </span>
      <span class="inline-flex items-center">
        <Icon class="w-4 h-4 mr-1" name="mdi:map-marker" />
        {talk.data.location}
      </span>
    </div>

    <p
      class="mt-3 text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3"
    >
      {talk.data.description}
    </p>

    <CardFooter tags={talk.data.tags}>
      {
        talk.data.recordingUrl && (
          <a
            href={talk.data.recordingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-press inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent-700 hover:bg-accent-800 text-white dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 font-semibold text-sm"
          >
            <Icon class="w-4 h-4" name="mdi:video-outline" />
            Watch recording
          </a>
        )
      }
      {
        talk.data.slidesUrl && (
          <a
            href={talk.data.slidesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={
              talk.data.recordingUrl
                ? "inline-flex items-center gap-1.5 text-sm font-medium text-stone-600 dark:text-stone-300 underline decoration-stone-300 dark:decoration-stone-600 underline-offset-4 hover:text-accent-700 hover:decoration-accent-500 dark:hover:text-accent-300"
                : "cta-press inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent-700 hover:bg-accent-800 text-white dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 font-semibold text-sm"
            }
          >
            <Icon class="w-4 h-4" name="mdi:file-document-outline" />
            View slides
          </a>
        )
      }
    </CardFooter>
  </div>
</section>
