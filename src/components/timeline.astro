---
import { Icon } from "astro-icon/components";

interface TimelineEvent {
  year: string;
  title: string;
  description: string;
  icon?: string;
  highlight?: boolean;
}

const timelineEvents: TimelineEvent[] = [
  {
    year: "Early Days",
    title: "Born in Mumbai Slum",
    description:
      "Grew up in a typical slum, with cricket as first love. Performed poorly on 10th exams but never gave up.",
    icon: "mdi:baby-face-outline",
  },
  {
    year: "Diploma",
    title: "Computer Science Diploma",
    description:
      "Chose computer science without thinking twice. Struggled with English but improved from 50% in first year to 60%+ by final year.",
    icon: "mdi:school-outline",
  },
  {
    year: "2005",
    title: "CS Degree Program",
    description:
      "Got admitted to Mumbai University. Borrowed books from library as couldn't afford to buy them. Family rallied together to support education.",
    icon: "mdi:certificate-outline",
  },
  {
    year: "2008",
    title: "The Great Recession",
    description:
      "First job during the recession at ₹5,000/month ($68 USD). Fell in love with C# programming.",
    icon: "mdi:currency-inr",
  },
  {
    year: "Jan 2010",
    title: "First Real Coding Job",
    description:
      "Got a job writing C# Windows applications. Within 10 months, received a 100% raise through hard work and learning.",
    icon: "mdi:code-braces",
  },
  {
    year: "Aug 2011",
    title: "Joined a Startup",
    description:
      "Worked for 5 years with 50%+ raise. Finally had insurance and PF. Built strong relationships through dedication.",
    icon: "mdi:rocket-launch-outline",
  },
  {
    year: "2012",
    title: "Daughter Born",
    description:
      "Wife had pregnancy complications. Daughter born at 845g. Hospital bill was 8L ($11K USD). Friends and manager supported through the crisis.",
    icon: "mdi:heart-outline",
    highlight: true,
  },
  {
    year: "2015",
    title: "First Personal Laptop",
    description:
      "Finally purchased a laptop to practice programming. Started building home from nothing after leaving parents' house.",
    icon: "mdi:laptop",
  },
  {
    year: "2016",
    title: "Moved to Pune",
    description:
      "Left the startup due to toxic management. Started prioritizing family time, working only 8 hours. Began writing tech blogs.",
    icon: "mdi:map-marker-outline",
  },
  {
    year: "2017",
    title: "New Beginnings",
    description:
      "Started Angular training, paid off loans, bought a bed, and got daughter into a good school. Joined Deutsche Bank.",
    icon: "mdi:trending-up",
  },
  {
    year: "Feb 2019",
    title: "Open Source Journey Begins",
    description:
      "Attended first Angular conference. Raised first PR to NgRx and then to Angular repo. Started contributing to community.",
    icon: "mdi:source-branch",
    highlight: true,
  },
  {
    year: "Jun 2019",
    title: "First OSS Project",
    description:
      "Created netlify-builder for Angular, now used by 200+ projects and part of Angular Docs.",
    icon: "mdi:package-variant-closed",
  },
  {
    year: "2019",
    title: "First Conference Talk",
    description:
      "Spoke at NgSrilanka in front of 300 developers. Overcame fear and improved by watching recordings.",
    icon: "mdi:microphone-outline",
  },
  {
    year: "Nov 13, 2019",
    title: "Google Developer Expert",
    description:
      "Became a GDE for Angular on birthday! Recognition came from consistent community contributions.",
    icon: "mdi:google",
    highlight: true,
  },
  {
    year: "Nov 2020",
    title: "India's First GitHub Star",
    description:
      "Nominated by fellow developers and became India's first GitHub Star. Proud to see Indian flag on the profile.",
    icon: "mdi:star",
    highlight: true,
  },
  {
    year: "2021",
    title: "Dream Realized",
    description:
      "Moved from slum where lived for 29 years to a multi-story rented apartment. The journey continues...",
    icon: "mdi:home-heart",
    highlight: true,
  },
  {
    year: "2022",
    title: "Moved to Germany",
    description:
      "Relocated to Germany for new opportunities. A new chapter begins in a new country.",
    icon: "mdi:airplane-takeoff",
    highlight: true,
  },
];
---

<section class="relative bg-stone-50 dark:bg-stone-900 overflow-hidden">
  <div
    class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16"
  >
    <!-- Hero Header -->
    <div class="text-center mb-12 sm:mb-16 max-w-4xl mx-auto">
      <h1
        class="text-5xl sm:text-6xl lg:text-7xl font-semibold leading-tight text-stone-900 dark:text-stone-100 mb-6 animate-fade-in-up"
      >
        My Journey
      </h1>
      <p
        class="text-lg sm:text-xl leading-relaxed text-stone-600 dark:text-stone-300 max-w-2xl mx-auto animate-fade-in-up animation-delay-80"
      >
        From the slums of Mumbai to becoming a recognized tech community leader
      </p>
      <div
        class="mt-8 flex justify-center animate-fade-in-up animation-delay-160"
      >
        <div
          class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-stone-800 rounded-full border border-stone-200 dark:border-stone-700"
        >
          <span class="w-2 h-2 bg-accent-600 rounded-full"></span>
          <span class="text-sm font-medium text-stone-600 dark:text-stone-300"
            >30+ years of persistence</span
          >
        </div>
      </div>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-6xl mx-auto">
      <div
        class="absolute left-5 top-0 bottom-0 w-px bg-stone-200 dark:bg-stone-700 lg:left-1/2 lg:-translate-x-1/2"
      >
      </div>

      <div class="space-y-10 lg:space-y-14">
        {
          timelineEvents.map((event, index) => {
            const onLeft = index % 2 === 0;
            return (
              <div
                class="timeline-item relative grid w-full grid-cols-[2.5rem_1fr] lg:grid-cols-2 lg:gap-x-16 items-start"
                style={`--delay: ${Math.min(index * 40, 160)}ms`}
              >
                <div class="relative z-10 flex justify-center lg:absolute lg:left-1/2 lg:top-1 lg:-translate-x-1/2">
                  <div
                    class={`w-10 h-10 rounded-full flex items-center justify-center ring-4 ring-stone-50 dark:ring-stone-900 ${
                      event.highlight
                        ? "bg-accent-700"
                        : "bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700"
                    }`}
                  >
                    <Icon
                      name={event.icon || "mdi:circle"}
                      class={`w-5 h-5 ${event.highlight ? "text-white" : "text-accent-600 dark:text-accent-400"}`}
                    />
                  </div>
                </div>

                <div
                  class={
                    onLeft
                      ? "lg:col-start-1 lg:row-start-1 lg:text-right"
                      : "lg:col-start-2 lg:row-start-1"
                  }
                >
                  <div
                    class={`p-6 rounded-xl border bg-white dark:bg-stone-800 ${
                      event.highlight
                        ? "border-accent-400 dark:border-accent-700"
                        : "border-stone-200 dark:border-stone-700"
                    }`}
                  >
                    <p class="text-sm text-stone-500 dark:text-stone-400 mb-2">
                      {event.year}
                    </p>
                    <h3 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-2">
                      {event.title}
                    </h3>
                    <p class="text-base text-stone-600 dark:text-stone-300 leading-relaxed">
                      {event.description}
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- End marker -->
      <div class="relative mt-16 flex justify-center">
        <div class="relative">
          <div
            class="relative w-16 h-16 rounded-full bg-accent-700 flex items-center justify-center ring-4 ring-stone-50 dark:ring-stone-900"
          >
            <Icon name="mdi:infinity" class="w-8 h-8 text-white" />
          </div>
        </div>
      </div>
    </div>

    <!-- Quote Section -->
    <div class="mt-12 sm:mt-16 text-center max-w-3xl mx-auto">
      <blockquote class="relative">
        <div
          class="absolute -top-4 left-1/2 -translate-x-1/2 text-8xl text-accent-200 dark:text-accent-900 font-display"
        >
          "
        </div>
        <p
          class="relative z-10 text-3xl lg:text-4xl font-display font-semibold text-stone-800 dark:text-stone-100 italic"
        >
          To quit is not an option
        </p>
      </blockquote>
      <p class="mt-6 text-lg text-stone-500 dark:text-stone-400">
        The journey continues...
      </p>
    </div>
  </div>
</section>

<style>
  /* Fade in animations */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 250ms ease-out forwards;
  }

  .animation-delay-80 {
    animation-delay: 80ms;
    opacity: 0;
  }

  .animation-delay-160 {
    animation-delay: 160ms;
    opacity: 0;
  }

  .timeline-item {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 220ms ease-out,
      transform 220ms ease-out;
    transition-delay: var(--delay);
  }

  .timeline-item.animate-ready {
    opacity: 0;
    transform: translateY(12px);
  }

  .timeline-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .animation-delay-80,
    .animation-delay-160 {
      animation: none;
      opacity: 1;
    }

    .timeline-item,
    .timeline-item.animate-ready {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  function initTimeline() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const timelineItems = document.querySelectorAll(
      ".timeline-item:not([data-observed])",
    );
    if (!timelineItems.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    timelineItems.forEach((item) => {
      item.setAttribute("data-observed", "");
      const rect = item.getBoundingClientRect();
      if (rect.top < window.innerHeight - 50 && rect.bottom > 0) {
        return;
      }
      item.classList.add("animate-ready");
      observer.observe(item);
    });
  }

  document.addEventListener("astro:page-load", initTimeline);
</script>
