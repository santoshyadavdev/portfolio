---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";

export interface Props {
  base: string;
  page: Page<CollectionEntry<"blog">>;
}

// const { id } = Astro.params
const { base, page } = Astro.props;

const root = base.replace(/\/\d+$/, "").replace(/\/$/, "");
const pageHref = (i: number) => root + (i > 1 ? "/" + i : "");
---

<div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="flex items-center gap-4 text-sm font-medium">
    <a
      href={import.meta.env.BASE_URL + "categories"}
      class="text-accent-300 hover:text-white"
    >
      Categories
    </a>
    <a
      href={import.meta.env.BASE_URL + "tags"}
      class="text-accent-300 hover:text-white"
    >
      Tags
    </a>
  </div>
  {
    page.size < page.total && (
      <nav class="inline-flex items-center" aria-label="Pagination">
        <a
          href={
            page.url.prev
              ? import.meta.env.BASE_URL + page.url.prev.slice(1)
              : undefined
          }
          aria-disabled={!page.url.prev}
          class:list={[
            "inline-flex items-center px-2 py-1.5 rounded-l-lg border text-sm",
            page.url.prev
              ? "border-white/25 bg-white/10 text-white hover:bg-white/20"
              : "pointer-events-none border-white/15 bg-white/5 text-white/40",
          ]}
        >
          <span class="sr-only">Previous</span>
          <Icon class="h-5 w-5" name="mdi:chevron-left" />
        </a>
        {Array.from({ length: page.lastPage }, (_, index) => index + 1).map(
          (i) => (
            <a
              href={pageHref(i)}
              aria-current={i == page.currentPage ? "page" : undefined}
              class:list={[
                i == page.currentPage
                  ? "border-white bg-white text-stone-900"
                  : "border-white/25 bg-white/10 text-white hover:bg-white/20",
                "inline-flex items-center px-3 py-1.5 border-y border-r text-sm font-medium",
              ]}
            >
              {i}
            </a>
          ),
        )}
        <a
          href={
            page.url.next
              ? import.meta.env.BASE_URL + page.url.next.slice(1)
              : undefined
          }
          aria-disabled={!page.url.next}
          class:list={[
            "inline-flex items-center px-2 py-1.5 rounded-r-lg border-y border-r text-sm",
            page.url.next
              ? "border-white/25 bg-white/10 text-white hover:bg-white/20"
              : "pointer-events-none border-white/15 bg-white/5 text-white/40",
          ]}
        >
          <span class="sr-only">Next</span>
          <Icon class="h-5 w-5" name="mdi:chevron-right" />
        </a>
      </nav>
    )
  }
  <p class="text-sm text-stone-300">
    {page.start + 1}-{page.end + 1} of {page.total}
  </p>
</div>
