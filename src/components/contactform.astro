---
// Contact form component using Autosend API for email delivery
// API key is stored securely in environment variables (not exposed to frontend)
// Configure in Cloudflare Pages environment variables:
// - AUTOSEND_API_KEY: Your Autosend API key
// - AUTOSEND_FROM_EMAIL: Your verified sender email
// - TURNSTILE_SECRET_KEY: Cloudflare Turnstile secret key
//
// Turnstile site key is public and can be set here:
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<!-- Cloudflare Turnstile Script. Renders a widget only when it finds a
     .cf-turnstile element, which we omit when no site key is configured. -->
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<div
  class="bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-6"
>
  <form id="contact-form" class="space-y-6">
    <!-- Honeypot field for spam prevention (hidden from users) -->
    <div class="hidden" aria-hidden="true">
      <label for="website">Website</label>
      <input
        type="text"
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <label
          for="name"
          class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2"
        >
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your name"
          class="w-full px-4 py-3 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 placeholder-stone-500 dark:placeholder-stone-400 focus:ring-2 focus:ring-accent-600 focus:border-transparent"
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2"
        >
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="your.email@example.com"
          class="w-full px-4 py-3 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 placeholder-stone-500 dark:placeholder-stone-400 focus:ring-2 focus:ring-accent-600 focus:border-transparent"
        />
      </div>
    </div>

    <div>
      <label
        for="message"
        class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2"
      >
        Message <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="5"
        placeholder="Your message..."
        class="w-full px-4 py-3 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 placeholder-stone-500 dark:placeholder-stone-400 focus:ring-2 focus:ring-accent-600 focus:border-transparent resize-y"
      ></textarea>
    </div>

    <!-- Cloudflare Turnstile Widget (rendered only when a site key is set) -->
    {
      TURNSTILE_SITE_KEY && (
        <div
          class="cf-turnstile"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-theme="auto"
        />
      )
    }

    <div>
      <button
        type="submit"
        id="submit-btn"
        class="cta-press w-full sm:w-auto bg-accent-700 hover:bg-accent-800 text-white font-semibold text-base px-6 py-3 rounded-lg dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950"
      >
        Send Message
      </button>
    </div>

    <div id="form-status" class="hidden">
      <p id="success-message" class="hidden text-green-600 dark:text-green-400">
        Thank you! Your message has been sent successfully.
      </p>
      <p id="error-message" class="hidden text-red-600 dark:text-red-400">
        Oops! Something went wrong. Please try again later.
      </p>
      <p id="captcha-error" class="hidden text-red-600 dark:text-red-400">
        Please complete the captcha verification.
      </p>
    </div>
  </form>
</div>

<style>
  #form-status:not(.hidden) {
    transition:
      display 200ms allow-discrete,
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
    opacity: 1;
    transform: none;
  }

  @starting-style {
    #form-status:not(.hidden) {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #form-status:not(.hidden) {
      transition:
        display 200ms allow-discrete,
        opacity 200ms ease;
      transform: none;
    }

    @starting-style {
      #form-status:not(.hidden) {
        opacity: 0;
        transform: none;
      }
    }
  }
</style>

<script>
  // Contact form submission handler
  // API key is securely stored server-side in environment variables

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const formStatus = document.getElementById("form-status") as HTMLDivElement;
  const successMessage = document.getElementById(
    "success-message",
  ) as HTMLParagraphElement;
  const errorMessage = document.getElementById(
    "error-message",
  ) as HTMLParagraphElement;
  const captchaError = document.getElementById(
    "captcha-error",
  ) as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const name = (form.elements.namedItem("name") as HTMLInputElement)?.value;
    const email = (form.elements.namedItem("email") as HTMLInputElement)?.value;
    const message = (form.elements.namedItem("message") as HTMLTextAreaElement)
      ?.value;
    const website = (form.elements.namedItem("website") as HTMLInputElement)
      ?.value;

    // Get Turnstile token
    const turnstileResponse = (
      form.elements.namedItem("cf-turnstile-response") as HTMLInputElement
    )?.value;

    // Validate captcha only when the Turnstile widget is present
    const turnstileEnabled = !!form.querySelector(".cf-turnstile");
    if (turnstileEnabled && !turnstileResponse) {
      formStatus.classList.remove("hidden");
      captchaError.classList.remove("hidden");
      return;
    }

    // Disable button and show loading state
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";
    formStatus.classList.add("hidden");
    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");
    captchaError.classList.add("hidden");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          name,
          email,
          message,
          website,
          turnstileToken: turnstileResponse,
        }),
      });

      if (response.ok) {
        formStatus.classList.remove("hidden");
        successMessage.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Sent";
        form.reset();
        if (typeof window.turnstile !== "undefined") {
          window.turnstile.reset();
        }
      } else {
        throw new Error("Failed to send message");
      }
    } catch (error) {
      console.error("Error sending message:", error);
      formStatus.classList.remove("hidden");
      errorMessage.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Send Message";
    }
  });
</script>
