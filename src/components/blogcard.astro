---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { categoryDetail, authorDetail } from "../config";
import Img from "../components/img.astro";
import Categories from "../components/categories.astro";
import Tags from "../components/tags.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const image =
  post.data.coverSVG ||
  post.data.coverImage ||
  (post.data.images && post.data.images[0]) ||
  post.data.socialImage ||
  categoryDetail(post.data.categories && post.data.categories[0]).coverSVG;
---

<section class="h-full">
  <div
    class="h-full flex flex-col group border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 rounded-xl overflow-hidden transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <a href={import.meta.env.BASE_URL + "blog/" + post.id}>
      <Img
        src={image}
        alt={post.data.title}
        class="relative w-full aspect-[1200/630] overflow-hidden object-center object-cover"
      />
      <p class="sr-only">{post.data.title}</p>
    </a>
    <div class="p-6 flex flex-col flex-1">
      <Categories categories={post.data.categories} />
      <a href={import.meta.env.BASE_URL + "blog/" + post.id}>
        <h3
          class="text-xl font-semibold text-stone-900 dark:text-stone-100 mt-2"
        >
          {post.data.title}
        </h3>
      </a>
      <div class="flex items-center flex-wrap">
        <span
          class="text-stone-500 dark:text-stone-400 mr-3 inline-flex items-center leading-none text-sm pr-3 py-1 border-r border-stone-200 dark:border-stone-700"
        >
          <Icon class="w-4 h-4 mr-1" name="mdi:calendar" />
          {post.data.publishDate.toDateString()}
        </span>
        {
          post.data.minutesRead && (
            <span class="text-stone-500 dark:text-stone-400 mr-3 inline-flex items-center leading-none text-sm pr-3 py-1 border-r border-stone-200 dark:border-stone-700">
              <Icon class="w-4 h-4 mr-1" name="mdi:clock" />
              {post.data.minutesRead}
            </span>
          )
        }
        {
          post.data.author && (
            <span class="text-stone-500 dark:text-stone-400 inline-flex items-center leading-none text-sm">
              <Img
                src={authorDetail(post.data.author).image}
                alt={post.data.author}
                class="w-5 h-5 rounded-full object-cover mr-1"
              />
              {post.data.author}
            </span>
          )
        }
      </div>

      <p
        class="mt-3 text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3 flex-1"
      >
        {post.data.description}
      </p>
      <div class="mt-auto">
        <Tags tags={post.data.tags} />
      </div>
    </div>
  </div>
</section>
