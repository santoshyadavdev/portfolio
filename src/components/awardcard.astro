---
import { Icon } from "astro-icon/components";

export interface Props {
  icon: string;
  title: string;
  year?: string | number;
  url?: string;
}

const { icon, title, year, url } = Astro.props;
---

<div class="group relative h-full">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="cta-press flex h-full w-full flex-col items-center justify-center bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl overflow-hidden transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <div class="flex flex-col items-center justify-center p-6">
      <Icon name={icon} class="w-10 h-10 mb-3" />
      <h3
        class="text-base font-semibold text-stone-900 dark:text-stone-100 text-center mb-1"
      >
        {title}
      </h3>
      <span
        class:list={[
          "inline-flex items-center leading-none text-sm",
          year ? "text-stone-500 dark:text-stone-400" : "invisible",
        ]}
      >
        <Icon class="w-4 h-4 mr-1" name="mdi:calendar" />
        Since {year || "0000"}
      </span>
    </div>
  </a>
</div>
