---
export interface Props {
  tags?: string[];
  variant?: "default" | "quiet";
}

const { tags, variant = "default" } = Astro.props;
---

{
  tags && tags.length > 0 && variant === "quiet" && (
    <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
      {tags.map((tag, i) => (
        <span class="inline-flex items-center gap-2">
          {i > 0 && (
            <span class="text-stone-300 dark:text-stone-600" aria-hidden="true">
              ·
            </span>
          )}
          <a
            href={`${import.meta.env.BASE_URL}tag/${encodeURIComponent(tag)}/`}
            class="text-xs text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200"
          >
            {tag}
          </a>
        </span>
      ))}
    </div>
  )
}

{
  tags && tags.length > 0 && variant === "default" && (
    <div class="flex flex-row flex-wrap items-start gap-1.5 mt-3">
      {tags.map((tag) => (
        <a
          href={`${import.meta.env.BASE_URL}tag/${encodeURIComponent(tag)}/`}
          class="inline-block px-2.5 py-0.5 rounded-full text-stone-600 dark:text-stone-300 bg-stone-100 dark:bg-stone-700 hover:bg-stone-200 dark:hover:bg-stone-600 font-medium text-xs transition-colors duration-150 ease"
        >
          {tag}
        </a>
      ))}
    </div>
  )
}
