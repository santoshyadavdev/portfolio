---
import { Icon } from "astro-icon/components";
import { authorDetail, Frontmatter } from "../config";
import Categories from "../components/categories.astro";
import Tags from "../components/tags.astro";
import Img from "../components/img.astro";

export interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
---

<div class="w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
  <div
    class="rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 p-6"
  >
    <Categories categories={frontmatter.categories} />
    <h1
      class="font-display text-3xl sm:text-4xl font-semibold leading-tight text-stone-900 dark:text-stone-100 break-words"
    >
      {frontmatter.title}
    </h1>
    <p
      class="text-base sm:text-lg md:text-xl font-display italic text-stone-600 dark:text-stone-300 mt-1"
    >
      {frontmatter.description}
    </p>
    <span class="flex flex-wrap gap-3 mt-4 text-sm sm:text-base">
      {
        frontmatter.author && (
          <span class="flex items-center">
            <Img
              src={authorDetail(frontmatter.author).image}
              alt={frontmatter.author}
              class="h-8 w-8 sm:h-10 sm:w-10 rounded-full mr-2 object-cover"
            />
            <span class="font-medium text-stone-900 dark:text-stone-100">
              {frontmatter.author}
            </span>
          </span>
        )
      }
      <span class="flex items-center">
        <Icon
          class="w-5 h-5 sm:w-6 sm:h-6 mr-1 text-accent-800 dark:text-accent-300"
          name="mdi:calendar"
        />
        <span class="font-medium text-stone-900 dark:text-stone-100 ml-1">
          {
            new Date(frontmatter.publishDate).toLocaleDateString(undefined, {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </span>
      </span>
      <span class="flex items-center">
        <Icon
          class="w-5 h-5 sm:w-6 sm:h-6 mr-1 text-accent-800 dark:text-accent-300"
          name="mdi:clock"
        />
        <span class="font-medium text-stone-900 dark:text-stone-100 ml-1">
          {frontmatter.minutesRead}
        </span>
      </span>
    </span>
    <Tags tags={frontmatter.tags} />
  </div>
</div>
