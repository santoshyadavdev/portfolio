---
import { Icon } from "astro-icon/components";
---

<div class="relative max-w-2xl">
  <form action="/search" method="get" role="search" class="relative">
    <label for="q" class="sr-only">Search blog posts</label>
    <Icon
      name="mdi:magnify"
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400"
      aria-hidden="true"
    />
    <input
      id="q"
      type="search"
      name="q"
      placeholder="Search blog posts..."
      class="w-full px-4 py-3 pl-12 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 placeholder-stone-500 dark:placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-accent-600 focus:border-transparent"
    />
  </form>
</div>
