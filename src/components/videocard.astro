---
import { Icon } from "astro-icon/components";
import type { YouTubeVideo } from "../lib/youtube";

export interface Props {
  video: YouTubeVideo;
}

const { video } = Astro.props;
const publishedDate = new Date(video.publishedAt);
const formattedDate = Number.isNaN(publishedDate.getTime())
  ? video.publishedAt
  : publishedDate.toDateString();
---

<section class="h-full">
  <div
    class="h-full flex flex-col group border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-800 rounded-xl overflow-hidden transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <a href={video.url} target="_blank" rel="noopener noreferrer">
      <img
        src={video.thumbnail}
        alt={video.title}
        loading="lazy"
        class="relative w-full h-56 bg-stone-100 dark:bg-stone-800 object-center object-cover"
      />
    </a>

    <div class="p-6 flex flex-col flex-1">
      <a href={video.url} target="_blank" rel="noopener noreferrer">
        <h3 class="text-xl font-semibold text-stone-900 dark:text-stone-100">
          {video.title}
        </h3>
      </a>

      <div
        class="mt-3 flex items-center flex-wrap gap-3 text-sm text-stone-500 dark:text-stone-400"
      >
        <span class="inline-flex items-center">
          <Icon class="w-4 h-4 mr-1" name="mdi:calendar" />
          {formattedDate}
        </span>
        <span class="inline-flex items-center">
          <Icon class="w-4 h-4 mr-1" name="logos:youtube-icon" />
          YouTube
        </span>
        {
          video.duration && (
            <span class="inline-flex items-center">
              <Icon class="w-4 h-4 mr-1" name="mdi:clock-outline" />
              {video.duration}
            </span>
          )
        }
      </div>

      <p
        class="mt-3 text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3 flex-1"
      >
        {video.description}
      </p>
    </div>
  </div>
</section>
