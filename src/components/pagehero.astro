---
import Img from "../components/img.astro";

export interface Props {
  title: string;
  description?: string;
  coverSVG?: string;
  coverImage?: string;
  socialImage?: string;
}

const { title, description, coverSVG, coverImage, socialImage } = Astro.props;
---

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div
    class="relative min-h-48 sm:min-h-56 overflow-hidden rounded-xl flex flex-col justify-end bg-stone-800"
  >
    <div
      class="absolute inset-0 z-10 bg-gradient-to-r from-stone-900/80 via-stone-900/25 to-transparent"
    >
    </div>
    <Img
      src={coverSVG || coverImage || socialImage}
      alt={title}
      class="absolute inset-0 z-0 w-full h-full object-contain object-right"
      loading="eager"
      fetchpriority="high"
    />
    <div class="relative z-20 p-5 sm:p-6 max-w-3xl">
      <h1
        class="font-display text-3xl sm:text-4xl font-semibold text-white leading-tight"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-2 text-lg text-stone-200 leading-relaxed">
            {description}
          </p>
        )
      }
      {
        Astro.slots.has("default") && (
          <div class="mt-5">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</div>
