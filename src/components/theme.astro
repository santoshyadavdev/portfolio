---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  class="cta-press ml-3 inline-flex items-center justify-center p-2 rounded-lg text-stone-500 hover:text-stone-900 hover:bg-stone-100 dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800 dark:focus:ring-accent-600 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-accent-600"
  aria-label="Toggle theme"
  onclick="window.applyTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark')"
>
  <span class="relative block h-5 w-5">
    <Icon
      class="theme-icon theme-icon-light h-5 w-5"
      aria-hidden="true"
      name="mdi:white-balance-sunny"
    />
    <Icon
      class="theme-icon theme-icon-dark absolute inset-0 h-5 w-5"
      aria-hidden="true"
      name="mdi:weather-night"
    />
  </span>
</button>
