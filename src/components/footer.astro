---
import { Logo, SiteMetadata } from "../config";
import Img from "../components/img.astro";
import { Icon } from "astro-icon/components";
---

<footer
  class="border-t border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-900"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center sm:justify-between gap-6"
  >
    <div class="flex items-center gap-3">
      <a
        class="flex items-center"
        href={import.meta.env.BASE_URL}
        aria-label="Home"
      >
        <Img src={Logo} alt="" class="dark:bg-stone-100 h-6 w-6" />
      </a>
      <p class="text-sm text-stone-600 dark:text-stone-400">
        © {new Date().getFullYear()} Santosh Yadav, MIT licence
      </p>
    </div>

    <div class="flex items-center gap-5">
      {
        SiteMetadata.social.map((s) => (
          <a
            href={s.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="text-stone-400 hover:text-accent-700 dark:text-stone-500 dark:hover:text-accent-300 transition-colors"
          >
            <Icon name={s.icon} class="w-5 h-5 block" />
          </a>
        ))
      }
      <span
        class="hidden sm:block w-px h-5 bg-stone-200 dark:bg-stone-700"
        aria-hidden="true"></span>
      <a
        href={import.meta.env.BASE_URL + "rss.xml"}
        class="text-sm font-medium text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400"
        >RSS</a
      >
      <a
        href={import.meta.env.BASE_URL + "sitemap-index.xml"}
        class="text-sm font-medium text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400"
        >Sitemap</a
      >
    </div>
  </div>
</footer>
