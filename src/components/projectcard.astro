---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Img from "./img.astro";
import CardFooter from "./cardfooter.astro";
import { DefaultSVG } from "../config";

export interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const hasTags =
  Array.isArray(project.data.tags) && project.data.tags.length > 0;
const coverImage = project.data.coverImage || DefaultSVG;
const isRemoteImage = /^https?:\/\//.test(coverImage);
---

<section class="h-full">
  <div
    class="h-full flex flex-col border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-800 rounded-xl overflow-hidden p-6 transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    {
      isRemoteImage ? (
        <img
          src={coverImage}
          alt={project.data.title}
          loading="lazy"
          class="relative w-full h-48 mb-4 bg-stone-100 dark:bg-stone-800 rounded-xl overflow-hidden object-center object-cover"
        />
      ) : (
        <Img
          src={coverImage}
          alt={project.data.title}
          class="relative w-full h-48 mb-4 bg-stone-100 dark:bg-stone-800 rounded-xl overflow-hidden object-center object-cover"
        />
      )
    }

    <h3 class="text-xl font-semibold text-stone-900 dark:text-stone-100">
      {project.data.title}
    </h3>

    <p
      class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300 line-clamp-3"
    >
      {project.data.description}
    </p>

    <CardFooter tags={hasTags ? project.data.tags : undefined}>
      <a
        href={project.data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-press inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent-700 hover:bg-accent-800 text-white dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 font-semibold text-sm"
      >
        <Icon class="w-4 h-4" name="mdi:open-in-new" />
        View project
      </a>

      {
        project.data.repoUrl && (
          <a
            href={project.data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-stone-600 dark:text-stone-300 underline decoration-stone-300 dark:decoration-stone-600 underline-offset-4 hover:text-accent-700 hover:decoration-accent-500 dark:hover:text-accent-300"
          >
            <Icon class="w-4 h-4" name="mdi:source-repository" />
            View source
          </a>
        )
      }
    </CardFooter>
  </div>
</section>
