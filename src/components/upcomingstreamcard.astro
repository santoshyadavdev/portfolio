---
import { Icon } from "astro-icon/components";
import type { UpcomingStream } from "../lib/youtube";

export interface Props {
  stream: UpcomingStream;
}

const { stream } = Astro.props;

const scheduledDate = new Date(stream.scheduledStartTime);
const formattedScheduledTime = Number.isNaN(scheduledDate.getTime())
  ? stream.scheduledStartTime
  : scheduledDate.toLocaleString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    });

const ctaLabel = stream.isLive ? "Watch Live" : "Set Reminder";
const statusText = stream.isLive ? "Live Now" : "Upcoming";
---

<section class="h-full">
  <article
    class="h-full flex flex-col border border-stone-200 bg-white dark:border-stone-700 dark:bg-stone-800 rounded-xl overflow-hidden transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
    aria-label={`${statusText}: ${stream.title}`}
  >
    <a href={stream.url} target="_blank" rel="noopener noreferrer">
      <img
        src={stream.thumbnail}
        alt={stream.title}
        loading="lazy"
        class="relative w-full h-56 bg-stone-100 dark:bg-stone-800 object-center object-cover"
      />
    </a>

    <div class="p-6 flex flex-col flex-1">
      <div
        class="inline-flex items-center px-3 py-1 rounded-full bg-accent-100 dark:bg-accent-900 text-accent-800 dark:text-accent-200 text-xs font-medium"
      >
        <span class="relative mr-2 flex h-2.5 w-2.5" aria-hidden="true">
          {
            stream.isLive && (
              <span class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 animate-ping motion-reduce:animate-none" />
            )
          }
          <span
            class={`relative inline-flex rounded-full h-2.5 w-2.5 ${stream.isLive ? "bg-red-500" : "bg-accent-600"}`}
          ></span>
        </span>
        {statusText}
      </div>

      <a href={stream.url} target="_blank" rel="noopener noreferrer">
        <h3
          class="mt-3 text-xl font-semibold text-stone-900 dark:text-stone-100 hover:text-accent-800 dark:hover:text-accent-400"
        >
          {stream.title}
        </h3>
      </a>

      <p
        class="mt-3 flex items-center gap-2 text-sm text-stone-500 dark:text-stone-400"
      >
        <Icon class="w-4 h-4" name="mdi:calendar-clock" />
        <span>{formattedScheduledTime}</span>
      </p>

      <p
        class="mt-3 text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3 flex-1"
      >
        {stream.description}
      </p>

      <a
        href={stream.url}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-press mt-5 inline-flex items-center px-4 py-2 rounded-lg bg-accent-700 hover:bg-accent-800 text-white dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 font-semibold text-base"
        aria-label={`${ctaLabel}: ${stream.title}`}
      >
        <Icon
          class="w-5 h-5 mr-2"
          name={stream.isLive ? "logos:youtube-icon" : "mdi:bell-ring-outline"}
        />
        {ctaLabel}
      </a>
    </div>
  </article>
</section>
