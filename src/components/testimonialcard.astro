---
import type { Testimonial } from "../lib/testimonials";
import { Icon } from "astro-icon/components";

export type Props = Testimonial;

const { quote, authorLogin, authorName, authorAvatarUrl, socialLinks } =
  Astro.props;

const platformIcons: Record<string, string> = {
  twitter: "mdi:twitter",
  linkedin: "mdi:linkedin",
  peerlist: "mdi:web",
  github: "mdi:github",
  bluesky: "bluesky",
  link: "mdi:open-in-new",
};
---

<div class="group relative h-full">
  <div
    class="relative w-full bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl overflow-hidden p-6 flex flex-col h-full transition-colors hover:bg-stone-50 dark:hover:bg-stone-700/50"
  >
    <!-- Quote -->
    <div class="flex-1 mb-4">
      <p
        class="text-stone-700 dark:text-stone-300 text-sm italic leading-relaxed"
      >
        &ldquo;{quote}&rdquo;
      </p>
    </div>

    <!-- Author -->
    <div
      class="flex items-center mt-auto pt-4 border-t border-stone-100 dark:border-stone-700"
    >
      <img
        src={authorAvatarUrl}
        alt={authorName}
        class="w-11 h-11 rounded-full object-cover mr-3 border border-stone-200 dark:border-stone-600"
      />
      <div class="flex-1 min-w-0">
        <p
          class="font-semibold text-stone-900 dark:text-stone-100 text-sm truncate"
        >
          {authorName}
        </p>
        <p class="text-stone-500 dark:text-stone-400 text-xs truncate">
          @{authorLogin}
        </p>
      </div>
      <!-- Social Links -->
      {
        socialLinks.length > 0 && (
          <div class="flex items-center gap-2 ml-2">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent-700 hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-400 transition-colors"
                aria-label={link.platform}
              >
                <Icon
                  name={platformIcons[link.platform] ?? "mdi:open-in-new"}
                  class="w-5 h-5"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
