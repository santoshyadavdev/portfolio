---
import { Icon } from "astro-icon/components";
import Base from "../layouts/base.astro";
import PageHero from "../components/pagehero.astro";
import ContactForm from "../components/contactform.astro";
import { SiteMetadata } from "../config";
import { getSocialStats, type SocialStats } from "../lib/socialstats";

// Fetch social stats at build time
const socialStats = await getSocialStats();

// Map platform names to their stat keys and labels
const platformStatMap: Record<
  string,
  { key: keyof SocialStats; label: string }
> = {
  Github: { key: "github", label: "followers" },
  Youtube: { key: "youtube", label: "subscribers" },
  Bluesky: { key: "bluesky", label: "followers" },
  Twitter: { key: "twitter", label: "followers" },
};

// Format large numbers with K/M suffix
function formatCount(count: number): string {
  if (count >= 1_000_000) {
    return (count / 1_000_000).toFixed(1).replace(/\.0$/, "") + "M";
  }
  if (count >= 1_000) {
    return (count / 1_000).toFixed(1).replace(/\.0$/, "") + "K";
  }
  return count.toString();
}

// Get follower/subscriber count for a platform
function getStatForPlatform(
  name: string,
): { count: string; label: string } | null {
  const mapping = platformStatMap[name];
  if (!mapping) return null;

  const count = socialStats[mapping.key];
  if (count === undefined) return null;

  return {
    count: formatCount(count),
    label: mapping.label,
  };
}

const frontmatter = {
  title: "Let's Connect",
  description: "Connect with me on your preferred platform",
  coverSVG: "../images/svg/undraw/santosh_yadav.svg",
  socialImage: "../images/santosh-og.jpg",
  publishDate: SiteMetadata.buildTime,
};
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      title={frontmatter.title}
      coverSVG={frontmatter.coverSVG}
      socialImage={frontmatter.socialImage}
    />
  </header>
  <main class="bg-white dark:bg-stone-900">
    <section
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-stone-800 dark:text-stone-100"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        <div class="lg:col-span-7">
          <h2
            class="text-2xl md:text-3xl font-semibold text-stone-900 dark:text-stone-100 mb-3"
          >
            Send me a message
          </h2>
          <p
            class="text-lg leading-relaxed text-stone-600 dark:text-stone-400 mb-8"
          >
            Have a question or want to work together? Write here.
          </p>
          <ContactForm />
        </div>

        <div class="lg:col-span-5">
          <h2
            class="text-2xl md:text-3xl font-semibold text-stone-900 dark:text-stone-100 mb-3"
          >
            Elsewhere
          </h2>
          <p
            class="text-lg leading-relaxed text-stone-600 dark:text-stone-400 mb-8"
          >
            Or pick a platform.
          </p>
          <div class="grid grid-cols-1 gap-4">
            {
              SiteMetadata.social.map(
                (method) =>
                  method.link && (
                    <a
                      href={method.link}
                      target={method.name === "Email" ? "_self" : "_blank"}
                      rel={
                        method.name === "Email"
                          ? undefined
                          : "noopener noreferrer"
                      }
                      class="cta-press group flex items-center gap-4 border border-stone-200 dark:border-stone-700 rounded-xl bg-white dark:bg-stone-800 p-6 hover:bg-stone-50 dark:hover:bg-stone-700/50 transition-colors"
                    >
                      <Icon
                        name={method.icon}
                        class="w-5 h-5 shrink-0 text-accent-700 dark:text-accent-300"
                        aria-hidden="true"
                      />
                      <span class="min-w-0">
                        <span class="block font-medium text-stone-900 dark:text-stone-100">
                          {method.name}
                        </span>
                        {(() => {
                          const stat = getStatForPlatform(method.name);
                          return stat ? (
                            <span class="block text-sm text-stone-500 dark:text-stone-400">
                              {stat.count} {stat.label}
                            </span>
                          ) : null;
                        })()}
                      </span>
                      <Icon
                        name="mdi:arrow-right"
                        class="w-4 h-4 ml-auto shrink-0 text-stone-400 group-hover:text-accent-700 dark:group-hover:text-accent-300"
                        aria-hidden="true"
                      />
                    </a>
                  ),
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
