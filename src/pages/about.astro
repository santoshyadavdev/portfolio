---
import Base from "../layouts/base.astro";
import Timeline from "../components/timeline.astro";

const frontmatter = {
  title: "My Journey",
  description:
    "From the slums of Mumbai to becoming a recognized developer advocate, GDE, and GitHub Star - this is my journey.",
  publishDate: new Date("2022-08-08"),
  coverSVG: "../images/svg/undraw/santosh_yadav.svg",
  socialImage: "../images/santosh-og.jpg",
};
---

<Base frontmatter={frontmatter}>
  <main class="dark:bg-stone-900">
    <!-- Full Page Timeline -->
    <Timeline />

    <!-- Read Full Story CTA -->
    <section
      class="py-12 sm:py-16 border-t border-stone-200 dark:border-stone-700"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-lg text-stone-600 dark:text-stone-300 mb-8">
          Want to read the complete story with all the details?
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://www.freecodecamp.org/news/my-journey-into-tech-from-slums-of-mumbai-to-my-own-apartment/"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-press inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-accent-700 hover:bg-accent-800 rounded-lg group"
          >
            Read My Full Story on freeCodeCamp
            <svg
              class="hover-nudge w-5 h-5 ml-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/press"
            class="cta-press inline-flex items-center px-6 py-3 text-base font-semibold text-stone-800 dark:text-stone-200 border border-stone-300 dark:border-stone-600 rounded-lg hover:border-accent-500 dark:hover:border-accent-500 group"
          >
            See Press Coverage
            <svg
              class="hover-nudge w-5 h-5 ml-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
