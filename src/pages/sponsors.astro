---
import type { Frontmatter } from "../config";
import { SiteMetadata } from "../config";
import Base from "../layouts/base.astro";
import PageHero from "../components/pagehero.astro";
import SponsorCard from "../components/sponsorcard.astro";
import { getSponsors } from "../lib/github";

const frontmatter: Frontmatter = {
  title: "People I Sponsor",
  description: "Amazing developers and organizations I support on GitHub",
  coverSVG: "../images/svg/undraw/santosh_yadav.svg",
  socialImage: "../images/santosh-og.jpg",
  publishDate: SiteMetadata.buildTime,
};

const { sponsors, totalMonthlyAmount } = await getSponsors();
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={frontmatter.coverSVG}
      socialImage={frontmatter.socialImage}
    />
  </header>
  <main class="bg-white dark:bg-stone-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      {
        sponsors.length > 0 ? (
          <>
            <div class="mb-8 text-center">
              <h2 class="text-2xl font-semibold text-stone-900 dark:text-stone-100">
                Total Monthly Support: ${totalMonthlyAmount}
              </h2>
            </div>
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {sponsors.map((sponsor) => (
                <SponsorCard
                  login={sponsor.login}
                  name={sponsor.name}
                  avatarUrl={sponsor.avatarUrl}
                  url={sponsor.url}
                />
              ))}
            </div>
          </>
        ) : (
          <div class="mt-6 text-center py-12">
            <p class="text-base text-stone-500 dark:text-stone-400">
              No sponsors to display at this time.
            </p>
            <p class="text-sm text-stone-500 dark:text-stone-500 mt-2">
              Configure GITHUB_TOKEN environment variable to display sponsor
              data.
            </p>
          </div>
        )
      }
    </div>
  </main>
</Base>
