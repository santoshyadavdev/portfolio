---
import type { Frontmatter } from "../config";
import { SiteMetadata } from "../config";
import Base from "../layouts/base.astro";
import PageHero from "../components/pagehero.astro";
import BlueskyPost from "../components/blueskypost.astro";
import { getBlueskyPosts } from "../lib/bluesky";

const frontmatter: Frontmatter = {
  title: "Bluesky Posts",
  description:
    "My latest posts and thoughts from Bluesky - follow me @santoshyadav.dev",
  coverSVG: "../images/svg/undraw/santosh_yadav.svg",
  socialImage: "../images/santosh-og.jpg",
  publishDate: SiteMetadata.buildTime,
};

const posts = await getBlueskyPosts();
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={frontmatter.coverSVG}
      socialImage={frontmatter.socialImage}
    />
  </header>
  <main class="bg-white dark:bg-stone-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <!-- Profile Link -->
      <div class="text-center mb-8">
        <a
          href="https://bsky.app/profile/santoshyadav.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-press inline-flex items-center py-2 px-4 rounded-lg bg-accent-700 hover:bg-accent-800 dark:bg-accent-300 dark:hover:bg-accent-400 dark:text-accent-950 text-white text-sm font-medium"
        >
          Follow me on Bluesky @santoshyadav.dev
        </a>
      </div>

      {
        posts.length > 0 ? (
          <div class="mt-8 lg:mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <BlueskyPost post={post} />
            ))}
          </div>
        ) : (
          <div class="mt-6 text-center py-12">
            <p class="text-base text-stone-500 dark:text-stone-400">
              No posts to display at this time.
            </p>
            <p class="text-sm text-stone-500 dark:text-stone-500 mt-2">
              Check back later for updates from Bluesky.
            </p>
          </div>
        )
      }
    </div>
  </main>
</Base>
