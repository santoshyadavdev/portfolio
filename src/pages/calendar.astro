---
import type { Frontmatter } from "../config";
import { SiteMetadata } from "../config";
import Base from "../layouts/base.astro";
import PageHero from "../components/pagehero.astro";

const frontmatter: Frontmatter = {
  title: "Community Calendar",
  description:
    "Stay up to date with upcoming CodeRabbit community events, live streams, and meetups.",
  coverSVG: "../images/svg/undraw/santosh_yadav.svg",
  socialImage: "../images/santosh-og.jpg",
  publishDate: SiteMetadata.buildTime,
};
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={frontmatter.coverSVG}
      socialImage={frontmatter.socialImage}
    />
  </header>

  <main
    class="bg-white dark:bg-stone-900"
    data-pagefind-body
    data-pagefind-meta={`title:${frontmatter.title}`}
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <p class="text-stone-600 dark:text-stone-400">
        This is the CodeRabbit Community calendar. Browse upcoming community
        events, live streams, and meetups happening across the CodeRabbit
        ecosystem.
      </p>
      <div class="mt-6 overflow-hidden rounded-xl">
        <iframe
          src="https://calendar.google.com/calendar/embed?src=c_3f1826e8de454fbbce5fcc4f29c070ac6cff53bc662e8b7385193a96f244e64a@group.calendar.google.com&ctz=Europe/Berlin"
          title="CodeRabbit Community Calendar"
          width="100%"
          height="700"
          class="block w-full"
          style="border:0;"></iframe>
      </div>
    </div>
  </main>
</Base>
