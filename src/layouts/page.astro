---
import type { Frontmatter } from "../config";
import Base from "../layouts/base.astro";
import PageHero from "../components/pagehero.astro";
export interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
---

<Base frontmatter={frontmatter}>
  <main class="dark:bg-stone-900">
    <article class="post">
      <header>
        <PageHero
          title={frontmatter.title}
          description={frontmatter.description}
          coverSVG={frontmatter.coverSVG}
          socialImage={frontmatter.socialImage}
        />
      </header>
      <section
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 prose prose-stone lg:prose-xl dark:prose-invert prose-pre:rounded-xl prose-headings:font-display prose-headings:font-semibold"
      >
        <slot />
      </section>
    </article>
  </main>
</Base>
