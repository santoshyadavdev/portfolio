---
import type { CollectionEntry } from "astro:content";
import type { PageMeta } from "../config";
import { getCollection } from "astro:content";
import Base from "./base.astro";
import PageHero from "../components/pagehero.astro";
import NextPrev from "../components/nextprev.astro";

type Props = {
  frontmatter: CollectionEntry<"course">["data"];
};

const { frontmatter } = Astro.props;
const currentPage = Astro.url.toString();

const docs = (await getCollection("course"))
  .sort((a, b) => a.data.weight - b.data.weight)
  .filter((p) => !p.data.draft);

const index = docs.findIndex((doc) => currentPage.includes(doc.id));
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;

const basefm: PageMeta = {
  title: frontmatter.title,
  description: frontmatter.description,
  publishDate: new Date(),
};
---

<Base frontmatter={basefm}>
  <main class="dark:bg-stone-900">
    <article>
      <header>
        <PageHero
          title={frontmatter.title}
          description={frontmatter.description}
        />
      </header>
      <section
        class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 prose prose-stone lg:prose-xl dark:prose-invert prose-pre:rounded-xl prose-headings:font-display prose-headings:font-semibold"
      >
        <slot />
      </section>
    </article>
  </main>
  <NextPrev
    slot="before-footer"
    base={import.meta.env.BASE_URL + "course/"}
    prev={prev}
    next={next}
  />
</Base>
